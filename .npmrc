# ─────────────────────────────────────────────────────────────
# pnpm configuration
#
# Read this before changing anything: one setting here silently breaks the
# production build on a clean machine. See `hoist` below.
# ─────────────────────────────────────────────────────────────

# `hoist` MUST stay at the default (enabled).
#
# It was once set to false to avoid rewriting a large symlink farm on every
# install, which is slow on Windows. That optimisation cost a broken build:
# Fastify plugins such as @fastify/static extend FastifyReply through TypeScript
# module augmentation, and to do that their .d.ts must be able to resolve the
# `fastify` peer dependency. pnpm's strict layout only exposes peers inside the
# hoisted `node_modules/.pnpm/node_modules` farm. With hoisting off that farm is
# empty, the augmentation silently does not apply, and `reply.sendFile` stops
# existing as far as the compiler is concerned.
#
# The failure is invisible on a machine that already had node_modules from an
# earlier install with hoisting on — which is exactly why it shipped. A clean
# clone or CI runner always fails. Verify with a fresh clone, not a warm one.

# Fail fast instead of prompting if a native build is required:
# better-sqlite3 ships prebuilds for this platform, so a source build means
# something is wrong and should be looked at.
strict-peer-dependencies=false

# Keep the lockfile layout stable across pnpm versions.
lockfile-version=9.0
