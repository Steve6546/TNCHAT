# ─────────────────────────────────────────────────────────────
# pnpm configuration
# ─────────────────────────────────────────────────────────────

# Only hoist to `node_modules/.pnpm/node_modules` what a package actually
# declares. Off by default here for two reasons: it keeps dependencies honest
# (an import that is not declared simply will not resolve), and it avoids
# rewriting a large symlink farm on every install, which is slow on Windows.
hoist=false

# Fail fast instead of prompting if a native build is required:
# better-sqlite3 ships prebuilds for this platform, so a source build means
# something is wrong and should be looked at.
strict-peer-dependencies=false

# Keep the lockfile layout stable across pnpm versions.
lockfile-version=9.0
