# ─────────────────────────────────────────────────────────────
# AI Command Center — environment template
#
# Copy this file to `.env` and adjust. `.env` is gitignored and must
# never be committed. No real secret belongs in this file.
#
#   cp .env.example .env      (macOS / Linux)
#   copy .env.example .env    (Windows)
#
# The single start command copies this file automatically when `.env`
# is missing, so a fresh clone runs with zero manual setup.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# ── Dashboard ─────────────────────────────────────────────────
# Leave this EMPTY. The dashboard then walks you through creating a password
# on first visit, and that password is stored as a scrypt hash in the database.
#
# A value here is honoured only until a password is stored, which makes it a
# convenience for scripted deployments — and a hazard if it is ever committed.
# This file is copied verbatim to .env on first run, so any value placed here
# becomes the real dashboard password on every machine that clones this repo.
# For that reason it ships empty and must stay empty in version control.
ADMIN_PASSWORD=

# ── Secrets ───────────────────────────────────────────────────
# Encrypts upstream provider keys at rest (AES-256-GCM).
# Leave empty on a dev machine: a persistent key is generated once and
# stored in server/data/.master-key. In production set it explicitly
# and back it up — losing it makes stored provider keys unreadable.
MASTER_KEY=

# Signs dashboard session tokens. Leave empty to derive one from
# MASTER_KEY. Set it in production to keep session signing separate
# from data-at-rest encryption.
SESSION_SECRET=

# ── Network ───────────────────────────────────────────────────
# Comma-separated allow-list, or `true` to reflect any origin.
# `true` is fine for local development only.
CORS_ORIGIN=true

# Set to `true` only when the server sits behind a trusted reverse
# proxy (nginx, Caddy, a load balancer) that sets X-Forwarded-For.
TRUST_PROXY=false

# ── Relay behaviour ───────────────────────────────────────────
# How many channels a failed request may try before giving up.
RETRY_TIMES=3

# Non-streaming upstream timeout.
REQUEST_TIMEOUT_MS=120000

# Streaming upstream timeout.
STREAMING_TIMEOUT_MS=300000

# Maximum inbound request body. Large image prompts need headroom.
MAX_REQUEST_BODY_MB=32

# Maximum buffer while scanning a single SSE frame from upstream.
STREAM_SCANNER_MAX_BUFFER_MB=64

# ── Paths ─────────────────────────────────────────────────────
# Optional overrides. Defaults live under server/data/.
# DB_PATH=
# ACC_DATA_DIR=
