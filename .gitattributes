# Text files normalise to LF in the repository. Windows checkouts keep LF for
# source; only .cmd/.bat/.ps1 get CRLF, because cmd.exe mishandles some LF-only
# batch constructs.
* text=auto eol=lf

*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binaries — never diff, never mangle.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text
*.woff binary
*.woff2 binary

# Lockfiles: keep them out of diffs and out of language statistics.
pnpm-lock.yaml -diff linguist-generated=true
package-lock.json -diff linguist-generated=true
