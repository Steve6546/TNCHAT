{
  "name": "@acc/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Command Center gateway — routes Anthropic and OpenAI traffic across provider channels",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db": "tsx src/db/migrate.ts",
    "bootstrap": "tsx src/db/bootstrap.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.0.4",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
